{
  "expo": {
    "name": "LogiQ",
    "slug": "logiq",
    "owner": "mrdeath2",
    "version": "2.0.3.2",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "scheme": "logiq",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "android": {
      "package": "com.logiq.app.pro",
      "versionCode": 136,
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      }
    },
    "ios": {
      "bundleIdentifier": "com.logiq.app.pro",
      "buildNumber": "136"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "enable16KBPages": true,
            "packagingOptions": {
              "jniLibs": {
                "useLegacyPackaging": false
              }
            }
          }
        }
      ],
      "expo-font",
      "expo-localization",
      "expo-dev-client",
      "react-native-iap"
    ],
    "extra": {
      "eas": {
        "projectId": "37df912e-e6c7-476d-9263-83143ac48e5f"
      }
    }
  }
}