{
  "expo": {
    "name": "LogiQ",
    "slug": "logiq",
    "owner": "mrdeath2",
    "version": "2.0.0.1",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "scheme": "logiq",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#00000000",
      "translucent": true
    },
    "android": {
      "package": "com.logiq.app.pro",
      "versionCode": 102
    },
    "ios": {
      "bundleIdentifier": "com.logiq.app.pro",
      "buildNumber": "102"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "enable16KBPages": true,
            "packagingOptions": {
              "jniLibs": {
                "useLegacyPackaging": false
              }
            }
          }
        }
      ],
      "expo-font",
      "expo-localization"
    ],
    "extra": {
      "eas": {
        "projectId": "37df912e-e6c7-476d-9263-83143ac48e5f"
      }
    }
  }
}