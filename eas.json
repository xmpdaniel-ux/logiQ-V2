{
    "build": {
        "production": {
            "android": {
                "image": "ubuntu-22.04-jdk-17-ndk-r27b",
                "buildType": "app-bundle",
                "ndk": "27.0.12077973",
                "gradleCommand": ":app:bundleRelease"
            },
            "env": {
                "NODE_VERSION": "20.18.0",
                "ANDROID_BUNDLE_ENABLE_UNCOMPRESSED_NATIVE_LIBS": "true",
                "GRADLE_OPTS": "-Dandroid.bundle.enableUncompressedNativeLibs=true -Dorg.gradle.jvmargs=-Xmx4g",
                "NPM_CONFIG_LEGACY_PEER_DEPS": "true"
            }
        }
    },
    "submit": {
        "production": {}
    },
    "cli": {
        "appVersionSource": "remote"
    }
}